# Variáveis no build da imagem (docker compose / Dockerfile).
# Para front e API no mesmo domínio com Nginx fazendo proxy em /api, deixe vazio:

# VITE_API_URL=
# VITE_API_BASE_URL=

# Se precisar apontar para URL absoluta (ex.: subdomínio da API), use HTTPS:
# VITE_API_URL=https://sistemavexa.com
# VITE_API_BASE_URL=https://api.seudominio.com/api

# Porta no host onde o Nginx do front escuta (docker-compose; padrão 8081):
# FRONT_PORT=8081
