# Copie para .env na mesma pasta do docker-compose.yml
# URL da API acessível pelo NAVEGADOR (não use localhost do servidor).
# Exemplo na mesma VPS:
VITE_API_URL=http://187.77.40.99:8080

# Opcional: se a API estiver em outro path/domínio completo (sobrescreve VITE_API_URL)
# VITE_API_BASE_URL=https://api.seudominio.com/api

# Porta no host onde o Nginx do front escuta (default 8081 para não conflitar com API em 8080)
FRONT_PORT=8081
